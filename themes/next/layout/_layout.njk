<!DOCTYPE html>
<html lang="{{ page.lang }}">
<head>
  {{ partial('_partials/head/head.njk', {}, {cache: theme.cache.enable}) }}
  {%- include '_partials/head/head-unique.njk' -%}
  <title>{% block title %}{% endblock %}</title>
  {{ partial('_third-party/analytics/index.njk', {}, {cache: theme.cache.enable}) }}
  {{ partial('_scripts/index.njk', {}, {cache: theme.cache.enable}) }}
  {{ partial('_third-party/index.njk', {}, {cache: theme.cache.enable}) }}
  {{ partial('_third-party/statistics/index.njk', {}, {cache: theme.cache.enable}) }}
  {%- include '_third-party/math/index.njk' -%}
  {%- include '_third-party/quicklink.njk' -%}
  {{- next_inject('head') }}
  <noscript>
    <link rel="stylesheet" href="{{ url_for(theme.css) }}/noscript.css">
  </noscript>
</head>

<body itemscope itemtype="http://schema.org/WebPage"{% if theme.motion.enable %} class="use-motion"{% endif %}>
  <div class="headband"></div>

  <main class="main">
    <div class="column">
      <header class="header" itemscope itemtype="http://schema.org/WPHeader">
        {%- include '_partials/header/index.njk' -%}
      </header>
      {%- if theme.sidebar.display !== 'remove' %}
        {% block sidebar %}{% endblock %}
      {%- endif %}
    </div>

    <div class="main-inner {% block class %}{% endblock %}">
      {%- include '_partials/header/sub-menu.njk' -%}
      {% block content %}{% endblock %}
      {%- include '_partials/comments.njk' -%}
    </div>
  </main>

  <footer class="footer">
    <div class="footer-inner">
      {%- include '_partials/languages.njk' -%}
      {{ partial('_partials/footer.njk', {}, {cache: theme.cache.enable}) }}
    </div>
  </footer>

  {{ partial('_partials/widgets.njk', {}, {cache: theme.cache.enable}) }}

  <!-- 全局悬浮像素猫 -->
  <div class="pet-wrapper" id="pet-wrapper">
    <div class="pet" id="pet" title="点我互动~">
      <!-- 像素猫 SVG -->
      <svg viewBox="0 0 32 32" width="48" height="48" id="pet-svg" shape-rendering="crispEdges">
        <!-- 耳朵 -->
        <rect x="6" y="2" width="4" height="5" fill="#d4956a"/>
        <rect x="22" y="2" width="4" height="5" fill="#d4956a"/>
        <rect x="7" y="3" width="2" height="3" fill="#ffb6c1"/>
        <rect x="23" y="3" width="2" height="3" fill="#ffb6c1"/>
        <!-- 头 -->
        <rect x="5" y="6" width="22" height="18" rx="3" fill="#f4a460"/>
        <!-- 脸白区 -->
        <rect x="9" y="14" width="14" height="8" fill="#fff8dc"/>
        <!-- 眼睛 -->
        <rect class="eye-l" x="10" y="11" width="4" height="5" fill="#222"/>
        <rect class="eye-r" x="18" y="11" width="4" height="5" fill="#222"/>
        <rect class="pupil-l" x="11" y="12" width="2" height="2" fill="#fff"/>
        <rect class="pupil-r" x="19" y="12" width="2" height="2" fill="#fff"/>
        <!-- 鼻子 -->
        <rect x="15" y="16" width="2" height="2" rx="1" fill="#ff9999"/>
        <!-- 嘴巴 -->
        <path class="pet-mouth" d="M13,19 L15,20 L17,19 L19,20" fill="none" stroke="#222" stroke-width="1" shape-rendering="geometricPrecision"/>
        <!-- 身体 -->
        <rect x="8" y="24" width="16" height="7" rx="2" fill="#f4a460"/>
        <!-- 尾巴 -->
        <path class="pet-tail" d="M24,28 L28,25 L29,28 L26,30" fill="#d4956a" shape-rendering="crispEdges"/>
      </svg>
      <!-- 气泡 -->
      <div class="pet-bubble" id="pet-bubble">喵~</div>
    </div>
  </div>

  <script>
  (function(){
    var pet = document.getElementById('pet');
    var bubble = document.getElementById('pet-bubble');
    var wrapper = document.getElementById('pet-wrapper');
    
    var state = 'idle';
    var clickCount = 0;
    var sleepTimer = null;
    
    var msgs = {
      welcome: ['欢迎来到本站！🐱', '喵~ 你来啦！', '今天也想学习吗？😺'],
      click: ['喵！', '喵呜~', '摸摸头~ 🐱💕', '别戳我啦~ 😹', '再戳我要生气了！😾', '好吧...再戳一下~ 😸'],
      sleep: ['zzZ... 💤', '好困啊... 😪', '让我眯一会...'],
      dark: ['天黑了~ 🌙', '晚上好呀 🐱‍👤'],
      light: ['早上好~ ☀️', '新的一天！🌅'],
      top: ['嗖~ 到顶了！⬆️', '飞上去啦~ 🚀'],
      konami: ['🎮 你发现了彩蛋！', '连击大师！🔥']
    };
    
    function pick(a){ return a[Math.floor(Math.random()*a.length)]; }
    function say(t){
      bubble.textContent=t; bubble.classList.add('pop');
      clearTimeout(bubble._t); bubble._t=setTimeout(function(){bubble.classList.remove('pop')},2500);
    }
    
    function setExpr(t){
      var el=document.querySelector('.eye-l'),er=document.querySelector('.eye-r'),m=document.querySelector('.pet-mouth');
      if(!el)return;
      if(t==='happy'){el.setAttribute('height','2');er.setAttribute('height','2');m.setAttribute('d','M13,18 L16,21 L19,18');}
      else if(t==='sleep'){el.setAttribute('width','5');el.setAttribute('height','1');er.setAttribute('width','5');er.setAttribute('height','1');m.setAttribute('d','M14,19 L18,19');}
      else{el.setAttribute('width','4');el.setAttribute('height','5');er.setAttribute('width','4');er.setAttribute('height','5');m.setAttribute('d','M13,19 L15,20 L17,19 L19,20');}
    }
    function resetEyes(){ setExpr('normal'); }
    
    pet.addEventListener('click',function(e){
      clickCount++;state='happy';setExpr('happy');
      // 滚动超过300px时，点击猫=返回顶部
      if(window.scrollY>300&&clickCount<=1){say(pick(msgs.top));pet.classList.add('pet-fly');setTimeout(function(){pet.classList.remove('pet-fly')},700);window.scrollTo({top:0,behavior:'smooth'});resetSleep();setTimeout(resetEyes,1000);return;}
      if(clickCount>=8){say(pick(msgs.konami));pet.classList.add('pet-spin');setTimeout(function(){pet.classList.remove('pet-spin')},600);clickCount=0;}
      else{say(pick(msgs.click));}
      pet.style.animation='none';pet.offsetHeight;pet.style.animation='pet-jump .4s ease';
      resetSleep();setTimeout(resetEyes,1000);
    });
    
    document.addEventListener('mousemove',function(e){
      if(state==='sleep')return;
      var r=pet.getBoundingClientRect();var cx=r.left+r.width/2;var cy=r.top+r.height*0.42;
      var dx=(e.clientX-cx)/20;var dy=(e.clientY-cy)/20;var d=Math.sqrt(dx*dx+dy*dy);
      if(d>3){dx=dx/d*3;dy=dy/d*3;}
      var pl=document.querySelector('.pupil-l'),pr=document.querySelector('.pupil-r');
      if(pl){pl.setAttribute('x',11+Math.round(dx));pl.setAttribute('y',12+Math.round(dy));}
      if(pr){pr.setAttribute('x',19+Math.round(dx));pr.setAttribute('y',12+Math.round(dy));}
    });
    

    function resetSleep(){clearTimeout(sleepTimer);pet.classList.remove('pet-sleeping');if(state==='sleep'){resetEyes();state='idle';}startSleep();}
    function startSleep(){clearTimeout(sleepTimer);sleepTimer=setTimeout(function(){state='sleep';setExpr('sleep');say(pick(msgs.sleep));pet.classList.add('pet-sleeping');},15000);}
    
    new MutationObserver(function(){var isDark=document.documentElement.getAttribute('data-theme')==='dark'||document.documentElement.classList.contains('dark');if(isDark){pet.classList.add('pet-dark');say(pick(msgs.dark));}else{pet.classList.remove('pet-dark');say(pick(msgs.light));}}).observe(document.documentElement,{attributes:true,attributeFilter:['class','data-theme']});

    // 滚动>300px时猫有光晕提示可返回顶部
    window.addEventListener('scroll',function(){if(window.scrollY>300){pet.classList.add('pet-can-top');}else{pet.classList.remove('pet-can-top');}},{passive:true});
    
    wrapper.classList.add('pet-enter');
    setTimeout(function(){say(pick(msgs.welcome));setExpr('happy');setTimeout(resetEyes,2000);},600);
    startSleep();
    
['mousedown','keydown','touchstart'].forEach(function(e){document.addEventListener(e,resetSleep,{passive:true});});
  })();
  </script>

  <style>
  .pet-wrapper{position:fixed;right:20px;bottom:20px;z-index:999;opacity:0;transform:translateY(30px) scale(0.6);transition:all .5s cubic-bezier(.34,1.56,.64,1);pointer-events:none;}
  .pet-wrapper.pet-enter{opacity:1;transform:translateY(0) scale(1);pointer-events:auto;}
  .pet{position:relative;cursor:pointer;animation:pet-idle 3s ease-in-out infinite;image-rendering:pixelated;image-rendering:-moz-crisp-edges;transition:transform .2s,box-shadow .3s;}
  .pet:hover{transform:scale(1.1);}
  .pet:hover .pet-tail{animation:tail-wag .25s ease-in-out infinite alternate;}
  .pet-bubble{position:absolute;bottom:100%;right:0;margin-bottom:8px;background:#fff;border:2px solid #f4a460;border-radius:10px;padding:6px 12px;font-size:.78em;color:#444;white-space:nowrap;box-shadow:0 2px 8px rgba(0,0,0,.08);opacity:0;transform:translateY(6px) scale(.8);transition:all .3s cubic-bezier(.68,-.55,.265,1.55);pointer-events:none;}
  .pet-bubble::before{content:'';position:absolute;bottom:-7px;right:16px;border:6px solid transparent;border-top-color:#f4a460;}
  .pet-bubble::after{content:'';position:absolute;bottom:-5px;right:17px;border:5px solid transparent;border-top-color:#fff;}
  .pet-bubble.pop{opacity:1;transform:translateX(0) scale(1);}
  .pet-sleeping{animation:pet-sleep 2.5s ease-in-out infinite!important;}
  .pet-can-top{box-shadow:0 0 12px rgba(244,164,96,.5),0 0 24px rgba(244,164,96,.25);animation:pet-glow-pulse 1.8s ease-in-out infinite alternate!important;}
  .pet-fly{animation:pet-fly-up .6s ease-out!important;}
  .pet-spin{animation:pet-spin-360 .45s ease!important;}
  @keyframes pet-idle{0%,100%{transform:translateY(0)}50%{transform:translateY(-3px)}}
  @keyframes pet-jump{0%{transform:translateY(0)}30%{transform:translateY(-14px)scale(1.05)}50%{transform:translateY(-8px)}70%{transform:translateY(-2px)scale(.97)}100%{transform:translateY(0)}}
  @keyframes pet-sleep{0%,100%{transform:translateY(0)}50%{transform:translateY(2px)}}
  @keyframes pet-fly-up{0%{transform:translateY(0)}40%{transform:translateY(-35px);opacity:1}100%{transform:translateY(0);opacity:1}}
  @keyframes pet-spin-360{from{transform:rotate(0deg)scale(1.1)}to{transform:rotate(360deg)scale(1.1)}}
  @keyframes tail-wag{from{transform:rotate(-10deg)}to{transform:rotate(10deg)}}
  @keyframes pet-glow-pulse{from{box-shadow:0 0 12px rgba(244,164,96,.5),0 0 24px rgba(244,164,96,.25)}to{box-shadow:0 0 18px rgba(244,164,96,.7),0 0 36px rgba(244,164,96,.35)}}
  html[data-theme="dark"] .pet-dark svg rect[fill="#f4a460"]{fill:#c98a54;}html[data-theme="dark"] .pet-dark .pet-bubble{background:#161b22;border-color:#d29966;color:#e6edf3;}html[data-theme="dark"] .pet-dark .pet-bubble::before{border-left-color:#d29966;}html[data-theme="dark"] .pet-dark .pet-bubble::after{border-left-color:#161b22;}
  @media(max-width:768px){.pet-wrapper{right:10px;bottom:10px;}.pet svg{width:40px;height:40px;}.pet-bubble{display:none;}}
  </style>

  {{- next_inject('bodyEnd') }}
</body>
</html>
