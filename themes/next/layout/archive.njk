{% extends '_layout.njk' %}
{% import '_macro/post-collapse.njk' as post_template with context %}
{% import '_macro/sidebar.njk' as sidebar_template with context %}

{% block title %}{{ __('title.archive') }} | {{ title }}{% endblock %}

{% block class %}archive posts-collapse{% endblock %}

{% block content %}

  {#####################}
  {### ARCHIVE BLOCK ###}
  {#####################}
  <div class="post-block">
    <div class="post-content">
      <div class="collection-title">
        {%- set posts_length = site.posts.length %}
        {%- if posts_length > 210 %}
          {%- set cheers = 'excellent' %}
        {% elif posts_length > 130 %}
          {%- set cheers = 'great' %}
        {% elif posts_length > 80 %}
          {%- set cheers = 'good' %}
        {% elif posts_length > 50 %}
          {%- set cheers = 'nice' %}
        {% elif posts_length > 30 %}
          {%- set cheers = 'ok' %}
        {% else %}
          {%- set cheers = 'um' %}
        {%- endif %}
        <span class="collection-header">{{ __('cheers.' + cheers) }}! {{ _p('counter.archive_posts', site.posts.length) }} {{ __('keep_on') }}</span>
      </div>

      {{ post_template.render(page.posts) }}

    </div>
  </div>
  {#########################}
  {### END ARCHIVE BLOCK ###}
  {#########################}

  {%- include '_partials/pagination.njk' -%}

  <div class="archive-tags">
    <h3 class="archive-tags-title">🏷️ 标签</h3>
    <div class="archive-tags-cloud">
      {%- set max_count = 1 -%}
      {%- for t in site.tags.toArray() -%}
        {%- if t.posts.length > max_count -%}{%- set max_count = t.posts.length -%}{%- endif -%}
      {%- endfor -%}
      {%- for tag in site.tags.sort('name').toArray() -%}
        {%- set ratio = tag.posts.length / max_count -%}
        {%- set fs = (13 + ratio * 10) | round(0) -%}
        <a href="{{ url_for(tag.path) }}" style="font-size: {{ fs }}px;">{{ tag.name }}<span>({{ tag.posts.length }})</span></a>
      {%- endfor -%}
    </div>
  </div>

<style>
.archive-tags { margin: 36px auto 20px; padding: 18px 4px; text-align: center; }
.archive-tags-title { font-size: 1.1em; font-weight: 700; margin: 0 0 16px; color: var(--text-color, #333); }
.archive-tags-cloud { display: flex; flex-wrap: wrap; gap: 8px; justify-content: center; line-height: 2.2; }
.archive-tags-cloud a {
  display: inline-block; padding: 3px 13px; border-radius: 14px;
  background: rgba(55,198,192,.09); color: var(--link-color, #37c6c0);
  text-decoration: none; transition: all .25s; border-bottom: none !important;
}
.archive-tags-cloud a:hover { background: #37c6c0; color: #fff !important; transform: scale(1.06); box-shadow: 0 2px 10px rgba(55,198,192,.35); }
.archive-tags-cloud a span { font-size: .72em; opacity: .5; margin-left: 2px; font-weight: 400; }
/* 暗色模式 */
html[data-theme="dark"] .archive-tags-title { color: #c9d1d9; }
html[data-theme="dark"] .archive-tags-cloud a {
  background: rgba(55,198,192,.15);
  color: #7ee8e0;
}
html[data-theme="dark"] .archive-tags-cloud a:hover {
  background: #37c6c0;
  box-shadow: 0 2px 12px rgba(55,198,192,.4);
}
html[data-theme="dark"] .archive-tags-cloud a span { opacity: .45; }
</style>

{% endblock %}

{% block sidebar %}
  {{ sidebar_template.render(false) }}
{% endblock %}
