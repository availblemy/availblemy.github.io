{% extends '_layout.njk' %}
{% import '_macro/sidebar.njk' as sidebar_template with context %}

{% block title %}{{ title }}{% if theme.index_with_subtitle and subtitle %} - {{ subtitle }}{% endif %}{% endblock %}

{% block class %}index custom-home{% endblock %}

{% block content %}
<div class="about-page">
  <!-- 小猫区域 -->
  <div class="cat-container">
    <div class="cat" id="cat">
      <svg viewBox="0 0 200 180" width="160" height="144">
        <!-- 耳朵 -->
        <polygon points="30,60 20,15 65,45" fill="#f4a460"/>
        <polygon points="170,60 180,15 135,45" fill="#f4a460"/>
        <polygon points="35,55 28,25 62,46" fill="#ffb6c1"/>
        <polygon points="165,55 172,25 138,46" fill="#ffb6c1"/>
        <!-- 头 -->
        <ellipse cx="100" cy="95" rx="75" height="60" fill="#f4a460"/>
        <!-- 脸部白色区域 -->
        <ellipse cx="100" cy="105" rx="50" height="38" fill="#fff8dc"/>
        <!-- 眼睛 -->
        <g class="cat-eyes">
          <ellipse class="eye-left" cx="72" cy="85" rx="12" ry="14" fill="#2d2d2d"/>
          <ellipse class="eye-right" cx="128" cy="85" rx="12" ry="14" fill="#2d2d2d"/>
          <circle class="pupil-left" cx="74" cy="83" r="5" fill="#fff"/>
          <circle class="pupil-right" cx="130" cy="83" r="5" fill="#fff"/>
        </g>
        <!-- 鼻子 -->
        <ellipse cx="100" cy="102" rx="6" ry="4" fill="#ff9999"/>
        <!-- 嘴巴 -->
        <path class="cat-mouth" d="M88,110 Q94,118 100,110 Q106,118 112,110" fill="none" stroke="#2d2d2d" stroke-width="1.8" stroke-linecap="round"/>
        <!-- 胡须 -->
        <g class="whiskers" stroke="#2d2d2d" stroke-width="1" opacity="0.5">
          <line x1="40" y1="98" x2="68" y2="102"/><line x1="38" y1="108" x2="66" y2="108"/>
          <line x1="160" y1="98" x2="132" y2="102"/><line x1="162" y1="108" x2="134" y2="108"/>
        </g>
      </svg>
    </div>
    <div class="cat-bubble" id="cat-bubble">喵~ 点我互动呀 🐱</div>
  </div>

  <!-- 自我介绍 -->
  <div class="about-intro">
    <p>🎓 成都信息工程大学</p>
    <p>📧 QQ: 2253922210</p>
    <p class="intro-text">我是 MalCode，一个热爱逆向工程和安全研究的大学生。平时喜欢分析恶意软件、写脚本、搞 CTF，偶尔也写写博客记录学习过程。欢迎来找我交流~ 😊</p>
  </div>
</div>

<script>
(function(){
  var bubble = document.getElementById('cat-bubble');
  var cat = document.getElementById('cat');
  
  var phrases = [
    '喵~ 点我互动呀 🐱',
    '喵呜~ 欢迎来到我的博客！',
    '🐾 我是 MalCode 的猫咪助手',
    '今天也要开心哦~ 😺',
    '想看技术文章？点导航栏~',
    '成都信息工程大学，喵~',
    '逆向工程很有趣的！🔍',
    'QQ: 2253922210，来找我玩呀~',
    '喵~ 你今天学什么了？📚',
    '摸摸头~ 🐱💕',
    '我是一只安全猫 🛡️',
    '饿了...有小鱼干吗？🐟'
  ];
  var idx = 0;
  
  function meow() {
    idx = (idx + 1) % phrases.length;
    bubble.innerHTML = phrases[idx];
    bubble.classList.add('pop');
    setTimeout(function(){ bubble.classList.remove('pop'); }, 300);
    
    // 小猫跳动
    cat.style.animation = 'none';
    cat.offsetHeight; // reflow
    cat.style.animation = 'cat-jump .5s ease';
    
    // 眼睛变化
    var eyes = document.querySelectorAll('.cat-eyes ellipse[rx="12"]');
    eyes.forEach(function(e){ e.setAttribute('ry', '4'); });
    setTimeout(function(){
      eyes.forEach(function(e){ e.setAttribute('ry', '14'); });
    }, 200);
  }
  
  cat.addEventListener('click', meow);
  bubble.addEventListener('click', meow);
  
  // 鼠标跟随眼睛
  document.addEventListener('mousemove', function(e){
    var rect = cat.getBoundingClientRect();
    var cx = rect.left + rect.width / 2;
    var cy = rect.top + rect.height * 0.48;
    var dx = (e.clientX - cx) / 30;
    var dy = (e.clientY - cy) / 30;
    var d = Math.sqrt(dx*dx + dy*dy);
    if(d > 4) { dx = dx/d*4; dy = dy/d*4; }
    var pl = document.querySelector('.pupil-left');
    var pr = document.querySelector('.pupil-right');
    if(pl) { pl.setAttribute('cx', 74+dx); pl.setAttribute('cy', 83+dy); }
    if(pr) { pr.setAttribute('cx', 130+dx); pr.setAttribute('cy', 83+dy); }
  });
  
  // 自动喵
  setInterval(function() {
    if(Math.random() > 0.7) {
      idx = Math.floor(Math.random() * phrases.length);
      bubble.innerHTML = phrases[idx];
      bubble.classList.add('pop');
      setTimeout(function(){ bubble.classList.remove('pop'); }, 300);
    }
  }, 10000);
})();
</script>

<style>
/* ===== About Page ===== */
.about-page {
  text-align: center;
  padding: 36px 20px 32px;
  background: linear-gradient(135deg, rgba(53,114,176,.05), rgba(80,168,232,.03));
  border-radius: 16px;
}

/* ===== Cat ===== */
.cat-container {
  position: relative;
  display: inline-block;
  margin-bottom: 20px;
  cursor: pointer;
}
.cat {
  animation: cat-idle 3s ease-in-out infinite;
  filter: drop-shadow(0 4px 10px rgba(244,164,96,.3));
  transition: transform .2s;
}
.cat:hover {
  transform: scale(1.06);
}

/* Speech Bubble */
.cat-bubble {
  position: absolute;
  top: -8px;
  left: 170px;
  background: #fff;
  border: 2px solid #f4a460;
  border-radius: 16px;
  padding: 11px 18px;
  font-size: .9em;
  color: #444;
  max-width: 220px;
  box-shadow: 0 3px 12px rgba(0,0,0,.08);
  line-height: 1.6;
  white-space: nowrap;
  transition: transform .3s cubic-bezier(.68,-.55,.265,1.55);
}
.cat-bubble::before {
  content: ''; position: absolute; left: -11px; top: 20px;
  border: 9px solid transparent; border-right-color: #f4a460;
}
.cat-bubble::after {
  content: ''; position: absolute; left: -7px; top: 22px;
  border: 7px solid transparent; border-right-color: #fff;
}
.cat-bubble.pop { transform: scale(1.08); }

/* About Intro */
.about-intro {
  max-width: 480px;
  margin: 0 auto;
}
.about-intro p {
  font-size: 1em;
  color: var(--text-color, #333);
  margin: 6px 0;
  line-height: 1.7;
}
.intro-text {
  margin-top: 14px !important;
  padding-top: 14px;
  border-top: 1px dashed rgba(53,114,176,.2);
  font-size: .92em !important;
  color: var(--text-secondary, #666) !important;
  line-height: 1.8 !important;
}

/* Animations */
@keyframes cat-idle {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-5px); }
}
@keyframes cat-jump {
  0% { transform: translateY(0) scaleY(1); }
  30% { transform: translateY(-18px) scaleY(1.08); }
  50% { transform: translateY(-12px) scaleY(1); }
  70% { transform: translateY(-4px) scaleY(0.96); }
  100% { transform: translateY(0) scaleY(1); }
}

/* Dark mode */
html[data-theme="dark"] .about-page {
  background: linear-gradient(135deg, rgba(88,166,255,.04), rgba(56,139,255,.02));
}
html[data-theme="dark"] .about-intro p { color: #e6edf3; }
html[data-theme="dark"] .intro-text { color: #8b949e !important; }
html[data-theme="dark"] .cat-bubble {
  background: #161b22; border-color: #d29966; color: #e6edf3;
}
html[data-theme="dark"] .cat-bubble::before { border-right-color: #d29966; }
html[data-theme="dark"] .cat-bubble::after { border-right-color: #161b22; }

/* Responsive */
@media (max-width: 800px) {
  .cat-bubble {
    position: static; margin-top: 14px; display: inline-block;
  }
  .cat-bubble::before, .cat-bubble::after { display: none; }
}
</style>
{% endblock %}

{% block sidebar %}
  {{ sidebar_template.render(false) }}
{% endblock %}
