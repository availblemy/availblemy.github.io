{% extends '_layout.njk' %}
{% import '_macro/sidebar.njk' as sidebar_template with context %}

{% block title %}{{ title }}{% if theme.index_with_subtitle and subtitle %} - {{ subtitle }}{% endif %}{% endblock %}

{% block class %}index custom-home{% endblock %}

{% block content %}
<div class="about-page">
  <!-- 机器人区域 -->
  <div class="robot-container">
    <div class="robot" id="robot">
      <div class="robot-head">
        <div class="robot-eyes">
          <div class="eye left"></div>
          <div class="eye right"></div>
        </div>
        <div class="robot-mouth"></div>
        <div class="robot-antenna">
          <div class="antenna-ball"></div>
        </div>
      </div>
      <div class="robot-body">
        <div class="robot-chest-light"></div>
      </div>
    </div>
    <div class="robot-bubble" id="robot-bubble">你好呀！我是 MalCode 的助手 🤖<br>点我试试~</div>
  </div>

  <!-- 关于信息 -->
  <div class="about-info">
    <h1 class="about-name">成都信息工程大学</h1>
    <p class="about-detail"><i class="fa fa-envelope"></i> QQ: 2253922210</p>
  </div>

  <!-- 快捷链接 -->
  <div class="about-links">
    <a href="/projects/"><i class="fa fa-code"></i> 开源项目</a>
    <a href="https://github.com/availblemy" target="_blank" rel="noopener"><i class="fab fa-github"></i> GitHub</a>
    <a href="/archives/"><i class="fa fa-book-open"></i> 技术文章</a>
  </div>
</div>

<script>
(function(){
  var bubble = document.getElementById('robot-bubble');
  var robot = document.getElementById('robot');
  var phrases = [
    '你好呀！我是 MalCode 的助手 🤖',
    '欢迎来到我的博客！',
    '想看项目？点下面链接~',
    '最近在研究恶意软件分析 🛡️',
    '今天也要加油哦！💪',
    '点我可以换句话~',
    '成都信息工程大学，了解一下？',
    'QQ: 2253922210，欢迎交流~',
    '逆向工程真的很有趣！',
    '你今天学什么了？📚'
  ];
  var idx = 0;
  
  function say() {
    idx = (idx + 1) % phrases.length;
    bubble.innerHTML = phrases[idx];
    bubble.classList.add('pop');
    setTimeout(function(){ bubble.classList.remove('pop'); }, 300);
    
    robot.style.animation = 'none';
    robot.offsetHeight;
    robot.style.animation = 'robot-bounce .4s ease';
  }
  
  robot.addEventListener('click', say);
  bubble.addEventListener('click', say);
  
  setInterval(function() {
    if (Math.random() > 0.7) {
      idx = Math.floor(Math.random() * phrases.length);
      bubble.innerHTML = phrases[idx];
      bubble.classList.add('pop');
      setTimeout(function(){ bubble.classList.remove('pop'); }, 300);
    }
  }, 8000);
})();
</script>

<style>
/* ===== About Page ===== */
.about-page {
  text-align: center;
  padding: 40px 20px 30px;
  background: linear-gradient(135deg, rgba(53,114,176,.06), rgba(80,168,232,.04));
  border-radius: 16px;
}

/* ===== Robot ===== */
.robot-container {
  position: relative;
  display: inline-block;
  margin-bottom: 24px;
  cursor: pointer;
}

.robot {
  width: 100px; height: 120px; position: relative;
  animation: robot-float 3s ease-in-out infinite;
}
.robot-head {
  width: 70px; height: 55px;
  background: linear-gradient(135deg, #5b9bd5, #3572b0);
  border-radius: 18px 18px 12px 12px;
  position: absolute; top: 0; left: 15px;
  box-shadow: 0 3px 12px rgba(53,114,176,.3);
}
.robot-eyes { display: flex; justify-content: center; gap: 14px; padding-top: 14px; }
.eye {
  width: 14px; height: 14px; background: #fff; border-radius: 50%;
  position: relative; animation: blink 4s ease-in-out infinite;
}
.eye::after {
  content: ''; position: absolute; width: 6px; height: 6px;
  background: #222; border-radius: 50%; top: 4px; left: 4px; transition: all .15s;
}
.robot:hover .eye.left::after { transform: translate(-2px, 0); }
.robot:hover .eye.right::after { transform: translate(2px, 0); }

.robot-mouth {
  width: 16px; height: 8px; background: #fff;
  border-radius: 0 0 10px 10px; margin: 6px auto 0; transition: all .2s;
}
.robot:hover .robot-mouth { height: 12px; border-radius: 50%; }

.robot-antenna {
  position: absolute; width: 3px; height: 16px;
  background: #3572b0; top: -14px; left: 50%; margin-left: -1.5px;
}
.antenna-ball {
  width: 10px; height: 10px; background: #e74c3c; border-radius: 50%;
  position: absolute; top: -10px; left: -3.5px;
  animation: antenna-glow 2s ease-in-out infinite alternate;
}
.robot-body {
  width: 56px; height: 45px;
  background: linear-gradient(135deg, #6ba3de, #4a90d9);
  border-radius: 10px 10px 16px 16px;
  position: absolute; top: 52px; left: 22px;
  box-shadow: 0 3px 12px rgba(53,114,176,.25);
}
.robot-chest-light {
  width: 14px; height: 14px; background: #2ecc71; border-radius: 50%;
  margin: 12px auto 0;
  box-shadow: 0 0 8px rgba(46,204,113,.6);
  animation: chest-pulse 2s ease-in-out infinite alternate;
}

/* Speech Bubble */
.robot-bubble {
  position: absolute; top: -10px; left: 120px;
  background: #fff; border: 2px solid #3572b0; border-radius: 14px;
  padding: 12px 18px; font-size: .88em; color: #333; max-width: 220px;
  box-shadow: 0 3px 12px rgba(0,0,0,.1); line-height: 1.55;
  white-space: nowrap;
  transition: transform .3s cubic-bezier(.68,-.55,.265,1.55);
}
.robot-bubble::before {
  content: ''; position: absolute; left: -10px; top: 20px;
  border: 8px solid transparent; border-right-color: #3572b0;
}
.robot-bubble::after {
  content: ''; position: absolute; left: -6px; top: 22px;
  border: 6px solid transparent; border-right-color: #fff;
}
.robot-bubble.pop { transform: scale(1.08); }

/* About Info */
.about-name { font-size: 1.6em; font-weight: 700; margin: 0 0 8px; color: var(--text-color); }
.about-detail { font-size: 1em; color: var(--text-secondary); margin: 0 0 18px; }
.about-detail i { color: #3572b0; margin-right: 6px; }

/* Links */
.about-links { display: flex; justify-content: center; gap: 12px; flex-wrap: wrap; }
.about-links a {
  display: inline-flex; align-items: center; gap: 5px;
  padding: 8px 18px; border-radius: 8px; font-size: .88em;
  text-decoration: none; transition: all .25s;
  color: #3572b0; background: rgba(53,114,176,.07);
  border: 1px solid rgba(53,114,176,.15);
}
.about-links a:hover { background: #3572b0; color: #fff; transform: translateY(-2px); }

/* Animations */
@keyframes robot-float { 0%,100%{transform:translateY(0)} 50%{transform:translateY(-6px)} }
@keyframes robot-bounce {
  0%{transform:translateY(0)rotate(0)} 25%{transform:translateY(-12px)rotate(-3deg)}
  50%{transform:translateY(0)rotate(0)} 75%{transform:translateY(-6px)rotate(3deg)}
  100%{transform:translateY(0)rotate(0)}
}
@keyframes blink { 0%,96%,100%{transform:scaleY(1)} 98%{transform:scaleY(0.1)} }
@keyframes antenna-glow {
  from{box-shadow:0 0 4px #e74c3c} to{box-shadow:0 0 12px #e74c3c,0 0 20px rgba(231,76,60,.3)}
}
@keyframes chest-pulse {
  from{opacity:1;box-shadow:0 0 8px rgba(46,204,113,.6)}
  to{opacity:.6;box-shadow:0 0 4px rgba(46,204,113,.3)}
}

/* Dark mode */
html[data-theme="dark"] .about-page {
  background: linear-gradient(135deg, rgba(88,166,255,.06), rgba(56,139,253,.03));
}
html[data-theme="dark"] .about-name { color: #e6edf3; }
html[data-theme="dark"] .robot-bubble { background: #161b22; border-color: #58a6ff; color: #e6edf3; }
html[data-theme="dark"] .robot-bubble::before { border-right-color: #58a6ff; }
html[data-theme="dark"] .robot-bubble::after { border-right-color: #161b22; }

/* Responsive */
@media (max-width: 800px) {
  .robot-bubble { position: static; margin-top: 16px; display: inline-block; }
  .robot-bubble::before, .robot-bubble::after { display: none; }
}
</style>
{% endblock %}

{% block sidebar %}
  {{ sidebar_template.render(false) }}
{% endblock %}
