{% extends '_layout.njk' %}
{% import '_macro/sidebar.njk' as sidebar_template with context %}

{% block title %}{{ title }}{% if theme.index_with_subtitle and subtitle %} - {{ subtitle }}{% endif %}{% endblock %}

{% block class %}index custom-home{% endblock %}

{% block content %}
<div class="about-page">
  <div class="about-intro">
    <p>🎓 成都信息工程大学</p>
    <p>📧 QQ: 2253922210</p>
    <p class="intro-text">我是 MalCode，一个热爱逆向工程和安全研究的大学生。平时喜欢分析恶意软件、写脚本、搞 CTF，偶尔也写写博客记录学习过程。欢迎来找我交流~ 😊</p>
  </div>
</div>

<style>
.about-page { text-align: center; padding: 50px 20px 40px; }
.about-intro { max-width: 480px; margin: 0 auto; }
.about-intro p { font-size: 1.05em; color: var(--text-color, #333); margin: 8px 0; line-height: 1.75; }
.intro-text {
  margin-top: 18px !important;
  padding-top: 18px;
  border-top: 1px dashed rgba(53,114,176,.2);
  font-size: .95em !important;
  color: var(--text-secondary, #666) !important;
  line-height: 1.85 !important;
}
</style>
{% endblock %}

{% block sidebar %}
  {{ sidebar_template.render(false) }}
{% endblock %}
